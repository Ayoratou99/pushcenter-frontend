# Backend
# API root, including the /api/v1 prefix.
VITE_API_BASE_URL=http://localhost:8000/api/v1
VITE_API_TIMEOUT=30000

# Swagger UI embedded in the sidebar. Left empty, it is derived from
# VITE_API_BASE_URL (its origin + /api/documentation). Set it only when the
# documentation is served somewhere else.
VITE_API_DOCS_URL=

# App Configuration
VITE_APP_NAME=AninfPush Management
VITE_APP_VERSION=1.0.0

# Optional: Facebook app used by the WhatsApp connection flow
VITE_FACEBOOK_APP_ID=
